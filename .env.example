DATABASE_URL=
MANUAL_TEST_DATABASE_URL=
# Optional custom PEM CA. Supabase's public CA is bundled; never disable TLS verification.
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Server-only comma-separated administrator emails. Empty grants no administrator access.
ADMIN_EMAILS=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Providers saved in Developer Setting take priority over the LLM_* fallback.
QUOTA_GENERATE_DAILY=3

# Transactional mail (server only). Keep disabled until migration and delivery are verified.
BREVO_API_KEY=
EMAIL_OTP_SECRET=
EMAIL_NOTIFICATIONS_ENABLED=
SOCIAL_EMAIL_OTP_REQUIRED=
EMAIL_SITE_URL=
EMAIL_APP_DAILY_LIMIT=
CRON_SECRET=

# Hardware generation stays disabled until explicitly enabled with 1 after migrations 0012 and 0013.
PHYSICAL_PROJECTS_ENABLED=
